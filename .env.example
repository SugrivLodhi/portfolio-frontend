# Server-side only — NEVER prefix with NEXT_PUBLIC_.
# Used by /api/ai/session (mints short-lived Realtime client secrets)
# and /api/ai/chat (text fallback via the Responses API).
OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional model overrides
# Use a realtime model your OpenAI account supports.
# gpt-realtime-2.1-mini  is the smallest/cheapest realtime model.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=alloy
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Set to "true" to re-enable the old Gemini chat widget during migration
# NEXT_PUBLIC_LEGACY_BOT=false
